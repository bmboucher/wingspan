# Run output directories (runs/<experiment>/<run>/) are never tracked; the
# experiment's config files and README at runs/<experiment>/ are.
runs/*/*/
# Game-stats study outputs written directly at the experiment level.
runs/stats_test/
runs/release_stats/
*.pt
*.pth
# The release bundle shipped inside the wheel (src/wingspan/data/release/).
!src/wingspan/data/release/*.pt
# Pinned backwards-compatibility fixtures are the one sanctioned home for
# committed checkpoints — gzip-compressed (*.pt.gz, not matched by *.pt) and
# LFS-tracked via .gitattributes (see CLAUDE.md "Checkpoint compatibility
# policy").
.idea/
.vscode/
.claude/

*.log
*.lock